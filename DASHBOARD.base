views:
  - type: kanban
    name: KANBAN
    filters:
      and:
        - file.folder != "/"
        - file.folder != "IMAGES"
    groupBy:
      property: file.folder
      direction: ASC
    groupOrder:
      - DEVOPS
      - Troubleshoot
      - Windows
      - Topics
      - REPAIR
      - SERVER
      - INBOX
      - UBUNTU
    sort: []
    columnWidth: 270
    imageAspectRatio: 0.5
